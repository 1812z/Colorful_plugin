<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ArtemisRGB.Core" Version="1.2026.101.2" IncludeAssets="compile;build;buildTransitive" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="ArtemisRGB.Plugins.BuildTask" Version="2.0.0" PrivateAssets="all" />
    <Content Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
